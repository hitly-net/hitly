# OpenShell Gateway (gRPC endpoint)
# Production: OpenShell 0.1.2 on VM openshell (Tailscale 100.106.191.81)
# auth_mode=mtls, loopback ONLY https://127.0.0.1:17670
# IMPORTANT: Gateway is loopback-only by design for security. Do NOT weaken mTLS or bind 17670 off loopback.
OPENSHELL_GATEWAY_ADDR=127.0.0.1:17670

# Bearer token with config:read and config:write scopes (optional with mTLS)
OPENSHELL_BEARER_TOKEN=your_bearer_token_here

# TLS/mTLS Configuration (REQUIRED for production)
# Production client certs live under ~/.config/openshell/gateways/openshell/mtls/ on the VM
# Point these env vars to those paths. NEVER commit or paste PEMs/secrets.
OPENSHELL_TLS_CA_FILE=$HOME/.config/openshell/gateways/openshell/mtls/ca.pem
OPENSHELL_TLS_CERT_FILE=$HOME/.config/openshell/gateways/openshell/mtls/client-cert.pem
OPENSHELL_TLS_KEY_FILE=$HOME/.config/openshell/gateways/openshell/mtls/client-key.pem

# Optional: Override SSL target name for hostname verification
# Use when connecting to 127.0.0.1 with a cert that has a different CN
# OPENSHELL_TLS_SSL_TARGET_NAME_OVERRIDE=openshell.local

# Insecure mode (dev/test ONLY - NEVER use in production)
# Set to 1 to disable TLS and use insecure gRPC connection
# OPENSHELL_TLS_INSECURE=1

# Workspace name
OPENSHELL_WORKSPACE=your-workspace-name

# Sandbox IDs to monitor (comma-separated)
# Until WatchProposalInbox ships, the poller monitors these specific sandboxes
OPENSHELL_SANDBOX_IDS=sandbox-1,sandbox-2

# HITLy API base URL
HITLY_API_URL=http://localhost:3001

# HITLy project API key (create in HITLy project Config tab)
HITLY_API_KEY=hitly_your_api_key_here

# HITLy project ID
HITLY_PROJECT_ID=prj_your_project_id_here

# Polling interval (milliseconds)
# Default: 5000 (5 seconds)
POLL_INTERVAL_MS=5000
