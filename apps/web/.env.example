# n8n waitlist webhook. Defaults to the test URL in development and the live URL in production.
# WAITLIST_WEBHOOK_URL=https://flow.interweb-it.com/webhook-test/hitly-waitlist
# WAITLIST_WEBHOOK_URL=https://flow.interweb-it.com/webhook/hitly-waitlist

# Telemetry and usage data. Unset = off (default). Self-hosted HITLy collects none.
# Only 1 or true enables Next.js CLI telemetry and the marketing-site Plausible
# snippet. Inbox / app pages never load Plausible. Wired through Next config,
# yarn scripts (scripts/with-hitly-telemetry.sh), systemd units, Docker Compose,
# and Dockerfile build/runtime stages (same flag, off by default).
# HITLY_TELEMETRY=1
#
# When HITLY_TELEMETRY is on, Plausible renders only if both domain and src are
# set (no hardcoded defaults). hitly.net example:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hitly.net
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://click.hitly.net/js/script.js
