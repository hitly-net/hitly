# Optional waitlist webhook (opt-in; no built-in default). Unset, empty or
# whitespace-only (the default): waitlist signups are accepted and NOTHING is
# posted to any external service. Set to a full URL to POST the payload JSON
# to that endpoint on each signup; a failing POST makes the route return 502.
WAITLIST_WEBHOOK_URL=

# We don't collect telemetry or usage data anywhere. Next.js and Turbo CLI
# telemetry are always off. HITLY_TELEMETRY only turns on the marketing-site
# Plausible page script (unset = no script). The value is trimmed; only 1 or
# true turn it on. Inbox never loads Plausible.
# Baked in at yarn build — changing these needs a rebuild.
# HITLY_TELEMETRY=1
#
# When HITLY_TELEMETRY is on, Plausible renders only if both domain and src are
# set (no hardcoded defaults). hitly.net example:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hitly.net
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://click.hitly.net/js/script.js
