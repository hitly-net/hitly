{
  "expo": {
    "name": "HITLy",
    "slug": "hitly",
    "scheme": "hitly",
    "version": "0.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icons/app-icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#2563eb"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#fafafa",
          "dark": {
            "image": "./assets/splash/splash-logo-dark.png",
            "backgroundColor": "#18181b"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "net.hitly.app",
      "supportsTablet": true,
      "icon": "./assets/icons/ios-icon.png",
      "associatedDomains": ["applinks:cloud.hitly.net"]
    },
    "android": {
      "package": "net.hitly.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-foreground.png",
        "backgroundColor": "#18181b",
        "monochromeImage": "./assets/icons/android-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cloud.hitly.net",
              "pathPrefix": "/inbox"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
