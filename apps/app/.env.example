# We don't collect telemetry or usage data anywhere. Next.js and Turbo CLI
# telemetry are always off. HITLY_TELEMETRY is the apps/web Plausible switch
# (trimmed; only 1 or true turn it on) and does not apply here. Inbox never
# loads Plausible.

WEB_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
# WebAuthn (passkeys) RP ID and origin are taken from BETTER_AUTH_URL (hostname and origin).
# Optional display name only — never a hostname.
# HITLY_WEBAUTHN_RP_NAME=HITLy
# Production requires a unique secret of at least 32 characters (this placeholder is refused). Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-char-secret
# 32-byte wrapping key for authenticator-app MFA secrets (standard base64). Generate with: openssl rand -base64 32
# Required in production. MFA enrol/verify fail closed when this is unset or not 32 bytes.
# HITLY_MFA_ENCRYPTION_KEY=
# Local development default for `yarn db:up` (Compose dev-only credentials; set real credentials in production).
DATABASE_URL=postgres://hitly:hitly@localhost:5432/hitly
# How long (ms) a request waits for a free Postgres connection before failing (default 5000).
# HITLY_DB_CONNECTION_TIMEOUT_MS=5000
# Postgres pool size (default 10, minimum 3). MFA confirm holds one connection while session
# revoke takes another; a pool smaller than 3 cannot serve that.
# HITLY_DB_POOL_MAX=10
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Mailer. Unset HITLY_MAIL_TRANSPORT: SMTP_HOST → smtp, else RESEND_API_KEY → resend, else log.
# HITLY_MAIL_TRANSPORT=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# HITLY_MAIL_FROM="HITLy <noreply@hitly.net>"
# RESEND_API_KEY=
# Optional Expo Push access token (higher rate limits / push security). Unauthenticated Expo Push still works at lower volume.
# EXPO_ACCESS_TOKEN=
# Optional. Serve Apple/Android association files so hosted email links open the HITLy app.
# HITLY_MOBILE_APP_ID=net.hitly.app
# HITLY_IOS_TEAM_ID=
# HITLY_ANDROID_SHA256=
# Optional. Extra browser origin allowed to call the API (Expo web is already allowed on localhost).
# HITLY_EXPO_ORIGIN=http://localhost:8081
# Optional. Comma-separated browser origins allowed to call the API with
# credentials (used in production, alongside BETTER_AUTH_URL; in production no
# private-network or loopback origin is trusted). Example:
# HITLY_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# HITLY_CORS_ALLOWED_ORIGINS=
# Local-use NAT64 origins (64:ff9b:1::/48) are always treated as private; serve the app same-origin if you need one.
# Optional. In-process housekeeping is on by default. Set to 0 and POST /api/v1/housekeeping from cron.
# HITLY_HOUSEKEEPING=0
# HITLY_CRON_SECRET=
# Optional. Enable public signup. Unset/1/true = on (default). 0/false/off = off (Cloud ships this).
# When off, /signup shows early-access landing. Host admin provisions accounts.
# HITLY_SIGNUP_ENABLED=false
# Optional. GA gate for unverified email addresses. Default OFF (closed beta
# does not block). Set 1/true/yes/on (case-insensitive, spaces trimmed) to
# enable (GA ships this on). While on, an
# unverified user can sign in but cannot create projects or API keys (stable
# error code email_not_verified; 403 in the REST API) and receives no
# work-item notifications (email or push). Verification/reset emails still
# send. Signed-in users see a banner with a rate-limited resend link.
# HITLY_REQUIRE_VERIFIED_EMAIL=false
# Optional. Outbound destinations (evidence sinks, OTEL endpoints, plugin URLs)
# get a destination check on every request. Private/loopback targets are
# allowed when NODE_ENV is not production. In production they are refused
# unless this is exactly "true" (server env only; logged once at startup).
# HITLY_ALLOW_PRIVATE_EVIDENCE_SINKS=true

# Reverse proxies in front of the app that append to X-Forwarded-For (default 1, at most 5).
# Per-client limits use the entry this many places from the right. With no reverse proxy
# in front, set 0: there is then no per-client address and those limits use one shared ceiling.
# HITLY_TRUSTED_PROXY_COUNT=1

# IP addresses / CIDR ranges of the reverse proxies in front of the app (comma-separated).
# When set, Better Auth's limiter and the app's per-client limits use the right-most
# X-Forwarded-For entry that is not one of these. Overrides HITLY_TRUSTED_PROXY_COUNT.
# HITLY_TRUSTED_PROXIES=
