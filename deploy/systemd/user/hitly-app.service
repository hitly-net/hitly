[Unit]
Description=HITLy app (Next.js production, :3001)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hitly
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=TURBO_TELEMETRY_DISABLED=1
ExecStart=/bin/bash -lc 'source "$HOME/.nvm/nvm.sh" && exec ./scripts/with-hitly-telemetry.sh yarn workspace @hitly/app start --hostname 0.0.0.0'
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
